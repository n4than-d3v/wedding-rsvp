</Wrapper>

<style>
    .languages {
        margin: 1rem 0rem;
    }

    form {
        width: 100%;
    }
    
    .language {
        padding: 0.25rem 0.5rem;
        font-size: 1.125rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 50%;
        margin: 0.5rem auto 0rem auto;
        background-color: rgba(0, 0, 0, 0.075);
        border: solid 1px black;
        cursor: pointer;
    }

    .language:hover, .language:focus {
        font-weight: bold;
        color: rgb(90, 46, 74);
        border-left: solid 3px rgb(90, 46, 74);
    }

    .language:hover span, .language:focus span {
        margin-left: -2px;
    }

    .language svg {
        max-width: 1.25rem;
        max-height: 1.25rem;
    }
</style>

@code
{
    [Parameter]
    public required string Token { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await _context.Init(Token, "en", false);
        
        if (_context.Party == null)
        {
            Navigation.NavigateTo("/not-found");
        }
    }

    private void SetLangEn() => OnSubmit("en");
    private void SetLangRo() => OnSubmit("ro");
    private void SetLangJp() => OnSubmit("jp");

    private void OnSubmit(string language)
    {
        if (_context.Party.Responded == null)
        {
            Navigation.NavigateTo($"/{language}/invite/{Token}/respond");
        }
        else
        {
            Navigation.NavigateTo($"/{language}/invite/{Token}/details");
        }
    }
}
