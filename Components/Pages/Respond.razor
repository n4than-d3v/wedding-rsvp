@page "/{language}/invite/{token}/respond"

@using Wedding.Components.Pages.Partials
@using Wedding.Services
@using Wedding.Commands

@inject IContext _context
@inject IGuestService _service
@inject NavigationManager Navigation

<PageTitle>October 3rd</PageTitle>

@if (_context.Party != null)
{
    <Wrapper>
        <form method="post" data-enhance @onsubmit="OnSubmit" @formname="Rsvp">
            <AntiforgeryToken />
        
            <Invitation />

            <YesNo />

            <div id="if-accept">            
                <Guests />
                <Questions />
            </div>

            <Button Save="true" />
        </form>
    </Wrapper>
}

<style>
    #if-accept {
        display: none;
    }

    form:has(#can:checked) #if-accept {
        display: block;
    }
</style>

@code
{
    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public string Language { get; set; }

    [SupplyParameterFromForm]
    public string Email { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    public string Diet { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    public string? PlusOneName { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    public string? Can { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    public int[] GuestsComing { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await _context.Init(Token, Language, true);
    }

    private async Task OnSubmit()
    {
        var command = new RsvpCommand
        {
            Token = Token,
            Email = Email,
            Diet = Diet,
            PlusOneName = PlusOneName,
            GuestsComing = Can == "yes" ? GuestsComing : []
        };

        await _service.Rsvp(command);
        
        Navigation.NavigateTo($"/{Language}/invite/{Token}/details");
    }
}
