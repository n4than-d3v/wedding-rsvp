@page "/{language}/invite/{token}/details"

@using Wedding.Components.Pages.Partials
@using Wedding.Services

@inject IContext _context
@inject NavigationManager Navigation

<PageTitle>October 3rd</PageTitle>

@if (_context.Party != null)
{
    <Wrapper>
        <Attendance />

        @if (_context.Party.AnyComing)
        {
            <Arrival />
            <ViewGuests />
            <ViewQuestions />
            <Button Save="false" />
            <ViewLogistics />
        }
        else
        {
            <Button Save="false" />
        }

    </Wrapper>
}

@code
{
    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public string Language { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await _context.Init(Token, Language, true);

    }
}
