@using Wedding.Services
@inject IContext _context

<h2 class="heading">@_context.GetMessage("logistics.location")</h2>

<p class="info">Northbrook Park, Farnham, Surrey, GU10 5EU<br />
    <a href="https://maps.app.goo.gl/3qvEmagQSuWTUHHA9">Google Maps</a> / 
    <a href="https://maps.apple.com/place?place-id=I56E449A718A52351">Apple Maps</a>
</p>

<h2 class="heading">@_context.GetMessage("logistics.train")</h2>

<p class="info">
    <a href="https://www.nationalrail.co.uk/stations/farnham">Farnham</a> (2 miles)
</p>

<h2 class="heading">@_context.GetMessage("logistics.hotels")</h2>

<p class="info">
    <a href="https://www.farnhamhousehotel.com/">Farnham House Hotel</a> (1 mile)<br />
    <a href="https://farnhambush.com/reserve/">Bush Hotel Farnham</a> (2 miles)<br />
    <a href="https://www.tellersarmsfarnham.co.uk/bedrooms/">Teller's Arms</a> (2 miles)
</p>

<h2 class="heading">@_context.GetMessage("logistics.taxis")</h2>

<p class="info">
    @_context.GetMessage("logistics.taxis.station")<br />
    <a href="https://farnham24hour-taxis.co.uk">Farnham 24 Hour Taxis</a> (01252 280 280)<br />
    <a href="https://www.farnham-taxis.com/">Prime Taxis Farnham</a> (01252 507 777)<br />
    <a href="https://vgtravel.co.uk/taxis-farnham/">VGT Taxis Farnham</a> (01252 737 475)
</p>

<h2 class="heading">@_context.GetMessage("logistics.abroad")</h2>

<p class="info">
    @_context.GetMessage("logistics.abroad.eta")<br />
    @_context.GetMessage("logistics.abroad.eta.check.before")<a href="https://www.gov.uk/check-uk-visa">@_context.GetMessage("logistics.abroad.eta.check.link")</a>@_context.GetMessage("logistics.abroad.eta.check.after")<br />
    @_context.GetMessage("logistics.abroad.eta.apply.before")<a href="https://www.gov.uk/eta/apply">@_context.GetMessage("logistics.abroad.eta.apply.link") </a>@_context.GetMessage("logistics.abroad.eta.apply.after")
</p>

<style>
    .info a:not(.button) {
        color: rgb(116, 45, 97);
    }
</style>
