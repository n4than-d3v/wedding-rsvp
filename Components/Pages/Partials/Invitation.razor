@using Wedding.Services
@inject IContext _context

<p id="invitation">
    @_context.GetMessage("invitation")
</p>

<p class="info">
    @_context.GetMessage("invitation.location.before")<a target="_blank" href="https://maps.app.goo.gl/3qvEmagQSuWTUHHA9">@_context.GetMessage("invitation.location.link")</a>@_context.GetMessage("invitation.location.after")
</p>


<style>
    #invitation {
        line-height: 1.25rem;
        margin: 0rem;
        margin-bottom: 0.5rem;
    }
</style>
