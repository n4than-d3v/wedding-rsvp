@using Wedding.Services
@inject IContext _context

<h2 id="questions">@_context.GetMessage("questions")</h2>

<div class="field">        
    <label for="email">@_context.GetMessage("questions.email")</label>
    <input type="email" id="email" name="Email" value="@_context.Party!.Email" autocomplete="email" placeholder="@_context.GetMessage("questions.email.placeholder")" />
</div>

<div class="field">        
    <label for="diet">@_context.GetMessage("questions.diet")</label>
    <input type="text" id="diet" name="Diet" value="@_context.Party!.Diet" placeholder="@_context.GetMessage("questions.diet.placeholder")" />
</div>

@if (_context.Party.Guests.Any(g => g.Name.Contains("1")))
{
    <div id="plus-one-field" class="field">        
        <label for="plus-one-name">@_context.GetMessage("questions.name.plus1")</label>
        <input type="text" id="plus-one-name" name="PlusOneName" value="@_context.Party!.PlusOneName" />
    </div>
}

@if (_context.Party.Housed)
{
    <p id="housed">@_context.GetMessage("housed")</p>
}

<style>
    #plus-one-field {
        display: none;
    }
    
    form:has(.plus-one-checkbox:checked) #plus-one-field {
        display: block;
    }

    .field {
        margin-bottom: 0.25rem;
        padding-bottom: 0.125rem;
    }

    .field label {
        padding-left: 0.125rem;
        color: rgb(36, 36, 36);
        margin-bottom: 0.25rem;
    }

    .field input {
        width: 75%;
        padding: 0.125rem 0.25rem;
        background-color: rgba(255, 255, 255, 0.35);
        border: none;
        border-bottom: dotted 2px grey;
        outline: none;
        margin-bottom: 0.25rem;
    }

    #housed {
        margin-bottom: 0.125rem;
    }
</style>
