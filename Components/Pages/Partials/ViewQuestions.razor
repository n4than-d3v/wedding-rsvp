@using Wedding.Services
@inject IContext _context

<h2 id="questions">@_context.GetMessage("questions")</h2>

<p class="answer">
    <strong>
        @_context.GetMessage("questions.email")
    </strong> @(string.IsNullOrWhiteSpace(_context.Party!.Email) ? "-" : _context.Party!.Email)
</p>

<p class="answer">
    <strong>
        @_context.GetMessage("questions.diet")
    </strong> @(string.IsNullOrWhiteSpace(_context.Party!.Diet) ? "-" : _context.Party!.Diet)
</p>

<style>
    input {
        background-color: transparent;
        color: black;
    }

    #housed {
        margin-bottom: 0.125rem;
    }

    .answer strong {
        display: block;
    }
</style>
