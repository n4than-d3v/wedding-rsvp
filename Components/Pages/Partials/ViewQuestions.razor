@using Wedding.Services
@inject IContext _context

<h2 id="questions">@_context.GetMessage("questions")</h2>

<p class="answer">
    <strong>
        @_context.GetMessage("questions.email")
    </strong> @(_context.Party!.Email ?? "-")
</p>

<p class="answer">
    <strong>
        @_context.GetMessage("questions.diet")
    </strong> @(_context.Party!.Diet ?? "-")
</p>

@if (_context.Party.Housed)
{
    <p id="housed">@_context.GetMessage("housed")</p>
}

<style>
    input {
        background-color: transparent;
        color: black;
    }

    #housed {
        margin-bottom: 0.125rem;
    }

    .answer strong {
        display: block;
    }
</style>
