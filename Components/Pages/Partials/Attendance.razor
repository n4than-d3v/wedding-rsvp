@using Wedding.Services
@inject IContext _context

@if (_context.Party!.AnyComing)
{
    <p class="thank-you">
        @_context.GetMessage("attendance.thanks")
    </p>
}
else
{
    <p class="sorry">
        @_context.GetMessage("attendance.sorry")
    </p>

    <p class="sorry">
        @_context.GetMessage("attendance.another-time")
    </p>
}

<style>
    .sorry, .thank-you {
        line-height: 1.25rem;
        margin: 0rem;
        margin-bottom: 0.5rem;
    }
</style>
