@using Wedding.Services
@inject IContext _context

<h2 id="guests">@_context.GetMessage("guests")</h2>

<p id="confirm-guests">@_context.GetMessage("guests.confirm")</p>

<div class="guests">
    @foreach (var guest in _context.Party!.Guests.OrderBy(g => g.Id))
    {
        <label class="guest" for="guest-@guest.Id">
            <input type="checkbox"
                id="guest-@guest.Id"
                class="@(guest.Name.Contains("1") ? "plus-one-checkbox" : "")"
                name="GuestsComing"
                value="@guest.Id"
                checked="@(guest.Coming == true)" />
            <span class="box">
                <svg width="800px" height="800px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <title/>
                    <g id="Complete">
                        <g id="tick">
                            <polyline fill="none" points="3.7 14.3 9.6 19 20.3 5" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                        </g>
                    </g>
                </svg>
            </span>
            <span class="name">
                @guest.Name
            </span>
        </label>
    }
</div>

<style>
    .guest {
        border-bottom: dotted 2px grey;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding-bottom: 0.125rem;
        color: rgb(68, 68, 68);
        cursor: pointer;
    }

    .guest input {
        visibility: hidden;
        display: block;
        height: 0;
        width: 0;
        position: absolute;
        overflow: hidden;
    }

    .guest .box {
        height: 1rem;
        width: 1rem;
        border: 1px solid rgb(68, 68, 68);
        display: inline-block;
        position: relative;
    }

    .guest .box svg {
        display: none;
        max-width: 100%;
        max-height: 100%;
        position: absolute;
        top: 0rem;
        left: 0rem;
    }

    .guest .name {
    }

    .guest input[type=checkbox]:checked + .box,
    .guest input[type=radio]:checked + .box {
        border-color: black;
    }

    .guest input[type=checkbox]:checked + .box + .name,
    .guest input[type=radio]:checked + .box + .can-text {
        color: black;
        font-weight: bold;
    }

    .guest input[type=checkbox]:checked + .box svg,
    .guest input[type=radio]:checked + .box svg {
        display: initial;
    }
</style>
